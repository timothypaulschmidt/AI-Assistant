GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.5-flash,gemini-robotics-er-2-preview
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
GEMINI_COOLDOWN_SECONDS=300
GEMINI_UNAVAILABLE_SECONDS=3600
GEMINI_ERROR_COOLDOWN_SECONDS=60
REQUEST_TIMEOUT=300
SYSTEM_PROMPT=You are a helpful assistant.
ALLOW_PROMPT_OVERRIDE=true
# FortiAIGate addresses (empty until FortiAIGate is configured; the Traffic route refuses a FortiAIGate
# choice while they are empty). Set in an overlay once known:
#   FAIG_OLLAMA_BASE_URL  FAIG_GEMINI_BASE_URL  FAIG_MODEL_MAP  FAIG_VERIFY_TLS  FAIG_MCP_SERVER_URL
# The gateway key FAIG_API_KEY is a secret (faig-assistant-api-key), never put here.
