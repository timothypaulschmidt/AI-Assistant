# Copy to .env for reference. NEVER commit a real key.
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Tried in this order, then the local model. Models your key can't use are
# skipped automatically.
GEMINI_MODELS=gemini-3.6-flash,gemini-flash-latest,gemini-4-argon,gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-pro-preview

# Where Ollama is running (no trailing /v1)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# After a Gemini model returns 429, skip that model for this many seconds
GEMINI_COOLDOWN_SECONDS=300
# After a model returns 404 (not found / retired), skip it this long
GEMINI_UNAVAILABLE_SECONDS=3600
# After a 5xx or a connection failure, skip the model(s) this long
GEMINI_ERROR_COOLDOWN_SECONDS=60
REQUEST_TIMEOUT=180
SYSTEM_PROMPT=You are a helpful assistant.

# Prompt lab: lets the web page send its own system prompt, Local model only
# (never to Gemini). Leave off unless you want to test with it.
ALLOW_PROMPT_OVERRIDE=false
